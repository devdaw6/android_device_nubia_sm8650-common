<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="8dp">

    <EditText
        android:id="@+id/china_killer_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/china_killer_whitelist_search_hint"
        android:imeOptions="actionDone"
        android:inputType="textVisiblePassword"
        android:maxLines="1" />

    <ListView
        android:id="@+id/china_killer_app_list"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:layout_marginTop="8dp"
        android:choiceMode="none"
        android:fastScrollEnabled="true" />

    <TextView
        android:id="@+id/china_killer_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="16dp"
        android:text="@string/china_killer_whitelist_no_results"
        android:visibility="gone" />

</LinearLayout>
