<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/nubia_settings_title">

    <Preference
        android:key="nubia_side_trigger"
        android:title="@string/trigger_buttons_title"
        android:summary="@string/trigger_buttons_summary">
        <intent
            android:targetPackage="org.lineageos.settings"
            android:targetClass="org.lineageos.settings.trigger.TriggerActivity" />
    </Preference>

    <Preference
        android:key="nubia_power_caps"
        android:title="@string/powercap_title"
        android:summary="@string/powercap_summary">
        <intent
            android:targetPackage="org.lineageos.settings"
            android:targetClass="org.lineageos.settings.power.PowerActivity" />
    </Preference>

    <Preference
        android:key="nubia_automation"
        android:title="@string/automation_title"
        android:summary="@string/automation_summary">
        <intent
            android:targetPackage="org.lineageos.settings"
            android:targetClass="org.lineageos.settings.automation.AutomationActivity" />
    </Preference>

    <Preference
        android:key="nubia_china_killer"
        android:title="@string/china_killer_title"
        android:summary="@string/china_killer_toggle_summary">
        <intent
            android:targetPackage="org.lineageos.settings"
            android:targetClass="org.lineageos.settings.memory.ChinaKillerActivity" />
    </Preference>

</PreferenceScreen>
